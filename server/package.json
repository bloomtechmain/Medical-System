{
  "name": "pharmacy-server",
  "version": "1.0.0",
  "description": "Pharmacy Management System - Express API",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts --ignore-path .eslintignore",
    "test": "jest",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate -j sql create",
    "db:seed": "node dist/config/seed.js",
    "db:migrate:legacy-init": "node dist/config/migrate.js",
    "db:migrate:additions": "node dist/config/migrateAdditions.js",
    "db:migrate:lab-requests": "node dist/config/migrateLabRequests.js",
    "db:migrate:lab-user": "node dist/config/migrateLabUser.js",
    "db:migrate:patient-reports": "node dist/config/migratePatientReports.js",
    "db:migrate:access-requests": "node dist/config/migrateAccessRequests.js",
    "db:migrate:lab-view-requests": "node dist/config/migrateLabViewRequests.js",
    "db:migrate:vitals": "node dist/config/migrateVitals.js",
    "db:migrate:vitals-access": "node dist/config/migrateVitalsAccessType.js",
    "db:migrate:lab-assignment": "node dist/config/migrateLabAssignment.js",
    "db:migrate:patient-upload-vitals": "node dist/config/migratePatientUploadVitals.js",
    "db:migrate:appointments": "node dist/config/migrateAppointments.js",
    "db:check:version": "node dist/scripts/checkDbVersionSettings.js",
    "db:check:bloat": "node dist/scripts/checkAutovacuumBloat.js",
    "db:purge-soft-deleted": "node dist/scripts/purgeSoftDeleted.js",
    "queue:smoke-test": "node dist/scripts/smokeTestQueue.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-pg-migrate": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.12.0",
    "pg-boss": "^12.37.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.15.0",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.28.0": true,
    "tesseract.js@7.0.0": true
  }
}

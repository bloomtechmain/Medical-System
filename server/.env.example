PORT=5000
NODE_ENV=production

# --- Database ---
# Option A: Railway PostgreSQL (recommended — Railway injects this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: individual vars (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pharmacy_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
# Access token lifetime — kept short on purpose (SEC-17 auth): the refresh
# token (7-day, revocable, see public.refresh_tokens) is what controls real
# session length now, not this.
JWT_EXPIRES_IN=15m

# --- CORS ---
# Set to the Railway URL of your frontend (or same service URL if single-service)
CLIENT_URL=https://your-app.railway.app

# --- Mail (SEC-17 auth: password reset) ---
# Optional. Without SMTP_HOST set, reset emails are logged to the server
# console instead of sent — fine for local dev, not for anywhere real users
# will actually request a reset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=Core Health <no-reply@your-domain.com>

PORT=5000
NODE_ENV=production

# --- Database ---
# The running server must connect as corehealth_app (created by
# corehealth_database.sql / server/migrations/001_initial_schema.sql) — a
# non-superuser role with no BYPASSRLS. It is NOT the role migrations run as
# (see db:migrate below) and must never be the DB's bootstrap/owner user or
# "postgres" superuser: a superuser silently bypasses the clinical schema's
# row-level security.
#
# Option A: Railway PostgreSQL (recommended — Railway injects DATABASE_URL
# automatically, but it points at the bootstrap owner role by default; swap
# the user:password in it for corehealth_app's credentials before deploying)
DATABASE_URL=postgresql://corehealth_app:password@host:5432/dbname

# Option B: individual vars (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pharmacy_db
# DB_USER=corehealth_app
# DB_PASSWORD=your_password

# TLS (DATABASE_URL / DB_HOST connections). Defaults to verifying the server's
# certificate whenever DATABASE_URL is set. Only disable for local/dev:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=                 # optional: provider's CA certificate, PEM contents

# Pool sizing — must satisfy: DB_POOL_MAX x (number of running instances) + spare
# connections (migrations, psql, seed scripts) < the database's max_connections.
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Statement/lock/idle-in-transaction timeouts, applied at the session level.
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=3000

# --- Migrations (server/migrations, run via `npm run db:migrate`) ---
# Separate, more-privileged role: CREATEROLE + CREATE on the database, needed
# for schema/role DDL and as the owner of provision_tenant(). Still not a
# superuser and never BYPASSRLS. Falls back to DATABASE_URL if unset, which
# only works if DATABASE_URL's user already has those rights (e.g. the
# Railway bootstrap owner, for a brand-new database — see
# server/migrations/BASELINE.md for the existing production database).
# DATABASE_MIGRATOR_URL=postgresql://corehealth_migrator:password@host:5432/dbname

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
# Access token lifetime — kept short on purpose (SEC-17 auth): the refresh
# token (7-day, revocable, see public.refresh_tokens) is what controls real
# session length now, not this.
JWT_EXPIRES_IN=15m

# --- CORS ---
# Set to the Railway URL of your frontend (or same service URL if single-service)
CLIENT_URL=https://your-app.railway.app

# --- File storage (PRO-05) ---
# Uploads (prescriptions, lab reports/referrals, patient reports) go to local
# disk when AWS_S3_BUCKET is unset — fine for local dev/CI, and for a single
# long-lived instance, but NOT for ECS Fargate or anywhere more than one
# instance/task can run: each task's disk is separate and ephemeral. Set
# AWS_S3_BUCKET to switch to S3 (see server/utils/fileStorage.ts). No access
# key/secret here — credentials come from the normal AWS credential chain
# (an ECS task role in production; `aws configure`/env vars for testing S3
# mode locally).
# AWS_S3_BUCKET=corehealth-uploads-prod
# AWS_REGION=us-east-1

# --- Soft-delete retention (PRO-25) ---
# Used by `npm run db:purge-soft-deleted` (server/scripts/purgeSoftDeleted.ts),
# an ops-run script, not an automatic job — see that file for why.
# PURGE_RETENTION_DAYS=90

# --- Mail (SEC-17 auth: password reset) ---
# Optional. Without SMTP_HOST set, reset emails are logged to the server
# console instead of sent — fine for local dev, not for anywhere real users
# will actually request a reset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=Core Health <no-reply@your-domain.com>
#
# Check it before relying on it:  npm run mail:test you@example.com
# That verifies host/port/TLS/credentials separately from sending, so a
# failure tells you which of the two is wrong.
#
# Port and SMTP_SECURE must agree, and getting this wrong is the most common
# mistake:  587 -> SMTP_SECURE=false (STARTTLS)   465 -> SMTP_SECURE=true
#
# Gmail / Google Workspace needs a 16-character App Password (requires 2FA on
# the account), never the account password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@your-domain.com
#   SMTP_PASSWORD=<16-char app password, no spaces>
#   SMTP_FROM=Core Health <you@your-domain.com>
#
# SMTP_FROM usually has to be an address the provider lets you send as.
# A mismatch is accepted at connection time and rejected at send time.
#
# CLIENT_URL above is NOT optional once mail works: the verification and reset
# links are built from it. Unset, sending now fails loudly rather than
# delivering an email with a broken link in it.

# Inbox that receives every public website form (Help contact, Share your
# story, newsletter sign-up). Defaults to help@suwale.com.
# CONTACT_INBOX=help@suwale.com

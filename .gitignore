# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output (Railway re-builds from source; never commit compiled output)
dist/
build/
client/dist/
server/dist/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Uploads (optional — remove if you want to track sample files)
server/uploads/

# Load test output (regenerated on every run — narrative results live in
# docs/capacity-plan.md instead)
scripts/loadtest/last-result.json

# Generated health report PDFs. An earlier version of
# healthReportPdf.test.ts called save() for real and left one of these in
# client/ — they are patient data by nature and must never be committed.
CoreHealth_Report_*.pdf

# Terraform local state (infra/terraform/versions.tf: local state until a
# remote S3+DynamoDB backend exists). State contains plaintext secrets
# (secrets.tf's JWT_SECRET, RDS master password) — never committed, same
# reasoning as server/.env.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfplan
infra/terraform/**/*.plan
infra/terraform/**/crash.log
infra/terraform/**/*.tfvars.json

# Downloaded provider plugins — regenerated by `terraform init`, ~600MB+,
# never belongs in git.
.terraform/

# Local state — once a real `terraform apply` runs, this holds live
# resource details (including, for some resource types, sensitive values).
# Doesn't exist yet in this repo since nothing has been applied, but
# ignored proactively for when it does.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# .terraform.lock.hcl is intentionally NOT ignored — it pins exact provider
# versions and should be committed, same as package-lock.json.
